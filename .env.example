# Copy this file to `.env` and fill in your real keys.

# === OpenAI ===
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EMBED_MODEL=text-embedding-3-small

# === Storage paths ===
# IMPORTANT: On a bare-metal server (non-Docker) point these at absolute paths
# on a persistent disk so data survives re-deploys.
#
# Example (Linux server):
#   DATA_DIR=/var/lib/rag/data          ← SQLite database (chat.db)
#   CHROMA_BASE_DIR=/var/lib/rag/chroma ← ChromaDB vectors
#   DOCUMENTS_DIR=/var/lib/rag/documents← uploaded PDF files
#
# When using Docker + docker-compose these directories are mounted from
# named volumes automatically — you do NOT need to change them.
DATA_DIR=./data
CHROMA_BASE_DIR=./chroma
DOCUMENTS_DIR=./documents

# === RAG ===
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=3

# === Auth ===
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin1234

# === Server ===
HOST=0.0.0.0
PORT=8000
